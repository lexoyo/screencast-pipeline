# screencast pipeline — config
# Copy to config.env and adjust. All paths may use $HOME.

# ---- tools ----
WHISPER_BIN="/opt/whisper.cpp/build-cuda/bin/whisper-cli"   # build CUDA (2026-08-20).
                                                            # CPU de secours : .../build/bin/whisper-cli
WHISPER_MODEL="$HOME/models/whisper/ggml-large-v3-turbo.bin"
                       # Sur GPU : 16 min d'audio en 46 s, 2,0 Go de VRAM. small = 31 s
                       # mais confond les noms propres. En CPU, revenir à ggml-small.bin.
FORCE_LANG="fr"        # AlexHoyau channel: FR first, EN second (Alex, 2026-08-09).
                       # "" or "auto" = let whisper detect, but it is unreliable on
                       # short/quiet clips, so state the language when you know it.
                       # Per-run override:  ./screencast --lang en new
                       # (the environment is NOT read: this file and --lang are the only
                       # two ways in. A Silex docs shoot is EN — see --channel silex.)
SHOTCUT_BIN="shotcut"                                  # Fedora RPM (/usr/bin/shotcut), NOT the flatpak
MELT_BIN="melt-7"                                      # ⚠️ on Fedora the MLT binary is `melt-7`
                                                       # (or `mlt-melt`). Plain `melt` does NOT exist
                                                       # and belongs to an unrelated package.
SONORITA_BIN="sonorita-cli"                            # musique des cartons — RPM externe, pas
                                                       # installé par scripts/install.sh
# ---- le cerveau : les cinq appels de modèle (montage, sous-titres, transcript,
#      métadonnées EN, QC éditorial). Prompt sur stdin, réponse sur stdout.
#      Décommenter UNE ligne.
CLAUDE_BIN="claude"                                          # Claude Code, avec le modèle de ta config
#CLAUDE_BIN="$HOME/_/screencast-pipeline/scripts/brain.sh"   # opencode, donc OpenRouter (cf. README)

# Le modèle, quand CLAUDE_BIN passe par brain.sh. Commenté = opencode reprend le dernier
# modèle utilisé dans son TUI. Décommenter UNE ligne. Le coût est celui d'UN montage
# (~50k tokens de transcript en entrée, ~2,5k de JSON en sortie), et le % est le score
# de suivi d'instructions (benchlm.ai, août 2026) — la capacité qui compte ici, puisque
# l'étape rend un JSON long et contraint.
#BRAIN_MODEL="openrouter/thinkingmachines/inkling-small"   # 2,5 c — 96,4 %, 1M de contexte
#BRAIN_MODEL="openrouter/qwen/qwen3.5-27b"                #   1 c — 93,7 %, le moins cher tenable
#BRAIN_MODEL="openrouter/nvidia/nemotron-3-ultra-550b-a55b" # 4 c — 95,3 %
#BRAIN_MODEL="openrouter/z-ai/glm-5.2"                    # 5,6 c — bon en JSON, non mesuré en FR
#BRAIN_MODEL="openrouter/x-ai/grok-4.3"                   # 7 c — 94,4 %
#BRAIN_MODEL="openrouter/qwen/qwen3.8-max"                #  11 c — 97,8 %, le meilleur du classement
#BRAIN_MODEL="openrouter/anthropic/claude-sonnet-5"       #  12 c — le repli sûr, ce qui tournait avant

# Effort de raisonnement, quand le modèle en accepte un : low, medium, high, xhigh, max.
# Vide = le réglage par défaut du fournisseur. Sur le montage, medium suffit.
#BRAIN_VARIANT="medium"

# Où archiver les échanges avec le modèle : un sous-dossier par appel, avec le prompt
# envoyé, la réponse reçue, le flux brut du fournisseur et les jetons facturés. Vide =
# rien n'est archivé (le décompte des jetons s'affiche quand même à l'écran).
#BRAIN_LOG=""

# Un fournisseur qu'opencode ne connaît pas, appelé directement en OpenAI-compatible.
# Renseigné, il court-circuite opencode. La clé reste ici : config.env n'est pas versionné.
#BRAIN_API_BASE="https://api.kalanda.ai/v1"
#BRAIN_API_KEY=""

# ---- inputs (relative to the episode dir passed to pipeline.sh) ----
SCREEN_FILE="screen.mkv"    # OBS main recording = screen capture (+ mic on its audio track)
FACE_FILE="face.mkv"        # Source Record output = clean webcam, frame-synced with screen
MIC_SOURCE="screen"         # which file carries the mic: "screen" or "face"

# ---- audio targets (adaptive: measured, then normalized to these) ----
AUDIO_LUFS="-16"            # YouTube spoken-word sweet spot (-14 louder, -16 safe)
AUDIO_TP="-1.5"            # true-peak ceiling dBTP
AUDIO_LRA="11"

# ---- face image target (adaptive eq is computed from measured luma/sat) ----
FACE_LUMA_TARGET="120"     # 0-255, mid-bright face

# ---- screencast scene: face picture-in-picture ----
PIP_SCALE="0.22"           # face width as fraction of 1920
PIP_MARGIN="28"            # px from the corner
PIP_CORNER="br"            # br bl tr tl

# ---- face scene: emphasis zoom (hard cut, centered close-up) ----
ZOOM_SCALE="1.4"

# ---- carton « point de liste » (flou + numéro géant, quand on énumère à l'oral) ----
LIST_BLUR="26"             # sigma du flou sur le plan
LIST_DARKEN="-0.14"        # assombrissement (eq=brightness), négatif
LIST_FADE="0.3"            # apparition du texte en secondes ; 0 = apparition sèche

# ---- silence removal ----
SILENCE_DB="-30dB"         # below this = silence
SILENCE_MIN="0.6"          # only cut silences longer than this (s)
SILENCE_PAD="0.15"         # keep this much padding around speech (s)

# ---- output ----
OUT_W="1920"
OUT_H="1080"
OUT_FPS="30"
DRAFT_CRF="20"

# ---- face/screen sync ----
# Empty = measure it from the OBS log (the reliable way). Set a number only to override.
FACE_OFFSET=""
